# Токен от @BotFather
BOT_TOKEN=123456:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram ID админов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=123456789

# Путь к файлу базы (внутри контейнера)
DB_PATH=data/bot.db

# Скорость рассылки, сообщений в секунду (потолок Telegram — 30)
MESSAGES_PER_SECOND=20

# Как часто планировщик проверяет очередь прогрева, секунд
TICK_SECONDS=60

# --- Если хостер блокирует api.telegram.org -------------------------------
# Вариант 1: зеркало Telegram API (например, Cloudflare Worker).
#            Указывай базовый адрес без /bot<token> на конце.
# TELEGRAM_API_BASE=https://tg.example.workers.dev
#
# Вариант 2: прокси наружу (SOCKS5 или HTTP), например SSH-туннель
#            на сервер, с которого Telegram доступен.
# TELEGRAM_PROXY=socks5://172.17.0.1:1080
